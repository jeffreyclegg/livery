# ============================================================
# CONDUCTOR · MOFFAT — btop
# The build machine's theme, Rev H. JDC.
#
# Install:  ~/.config/btop/themes/conductor-moffat.theme
# Config:   color_theme = "conductor-moffat"  (in btop.conf)
#
# Gradients run start, mid, end as the value rises.
#
# CPU carries the sunset run, its one appearance on this surface:
# #5E2F2C, #B06A48, #F2A33C. The run's first stop, dusk navy #2B2F3E,
# measures 1.5:1 on the ground and would erase idle load, so the
# gradient starts at the oxblood stop instead.
#
# Temperature reads as the three signal aspects: CLEAR, APPROACH, STOP.
# Used memory runs toward warbonnet because a full machine halts.
# Free is brunswick, cached is hudson, available is dusk.
#
# Gradient starts below the token are DERIVED: the token taken toward
# the ground so low values still read (2.6 to 3.2:1; graph marks, not
# text). Each one is marked.
# ============================================================

# ---- FOUNDATION ----
# spec: ground
theme[main_bg]="#130B0B"
# spec: ink
theme[main_fg]="#DADBDE"
# spec: ink. Box titles.
theme[title]="#DADBDE"
# spec: sodium. Hotkey letters: the thing you can press.
theme[hi_fg]="#F2A33C"
# spec: line strong. Ink on it measures 8.1:1.
theme[selected_bg]="#4D3532"
# spec: ink
theme[selected_fg]="#DADBDE"
# spec: ink label. Disabled options are still labels, so not the faint tier.
theme[inactive_fg]="#A4A6AB"
# spec: ink label
theme[graph_text]="#A4A6AB"
# spec: inset
theme[meter_bg]="#241817"
# spec: hudson. Process detail figures.
theme[proc_misc]="#A9B3C1"

# ---- STRUCTURE ----
# spec: line strong
theme[cpu_box]="#4D3532"
theme[mem_box]="#4D3532"
theme[net_box]="#4D3532"
theme[proc_box]="#4D3532"
# spec: line
theme[div_line]="#352423"

# ---- CPU: the sunset run ----
theme[cpu_start]="#5E2F2C"
theme[cpu_mid]="#B06A48"
theme[cpu_end]="#F2A33C"

# ---- TEMPERATURE: signal aspects ----
# brunswick, sodium, warbonnet
theme[temp_start]="#7DB592"
theme[temp_mid]="#F2A33C"
theme[temp_end]="#E2503E"

# ---- MEMORY ----
# Free: DERIVED brunswick dim, brunswick, DERIVED brunswick lit (Ghostty 10)
theme[free_start]="#3F6B51"
theme[free_mid]="#7DB592"
theme[free_end]="#A6D9B6"

# Cached: DERIVED hudson dim, hudson, DERIVED hudson polished (Ghostty 12)
theme[cached_start]="#56606E"
theme[cached_mid]="#A9B3C1"
theme[cached_end]="#CDD5DF"

# Available: DERIVED dusk dim, dusk, DERIVED dusk lit (Ghostty 13)
theme[available_start]="#5A507E"
theme[available_mid]="#A79AD0"
theme[available_end]="#C9BFEA"

# Used: DERIVED hudson dim, sodium, warbonnet
theme[used_start]="#56606E"
theme[used_mid]="#F2A33C"
theme[used_end]="#E2503E"

# ---- NETWORK ----
# Download is structure arriving: hudson.
theme[download_start]="#56606E"
theme[download_mid]="#A9B3C1"
theme[download_end]="#CDD5DF"
# Upload is the machine putting work out: DERIVED sodium dim, sodium,
# DERIVED sodium lit (Ghostty 11).
theme[upload_start]="#7A4A2A"
theme[upload_mid]="#F2A33C"
theme[upload_end]="#FFC46E"

# ---- PROCESSES ----
# Per-process CPU: hudson at rest, sodium when it is the one running.
# The mid stop is DERIVED, halfway between the two. btop draws process
# text in this gradient, so every stop is text-grade (about 9:1 or better).
theme[process_start]="#A9B3C1"
theme[process_mid]="#CDAB7E"
theme[process_end]="#F2A33C"
