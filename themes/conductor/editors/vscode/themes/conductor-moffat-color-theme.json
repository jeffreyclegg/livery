  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7E8086",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage.modifier",
        "keyword.control",
        "storage.type.function",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#F2A33C"
      }
    },
    {
      "name": "Operator / punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#A4A6AB"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "markup.inline.raw",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#7FC4CC"
      }
    },
    {
      "name": "Constant (Dusk, rare)",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#A79AD0"
      }
    },
    {
      "name": "Type / structure",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type"
      ],
      "settings": {
        "foreground": "#A9B3C1"
      }
    },
    {
      "name": "Builtin / self",
      "scope": [
        "variable.language",
        "support.constant",
        "support.variable"
      ],
      "settings": {
        "foreground": "#A9B3C1",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#DADBDE"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other.property",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#DADBDE"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#F2A33C"
      }
    },
    {
      "name": "Attribute",
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#A9B3C1"
      }
    },
    {
      "name": "Regexp / escape",
      "scope": [
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#A79AD0"
      }
    },
    {
      "name": "Decorator / macro",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "entity.name.function.macro",
        "meta.preprocessor"
      ],
      "settings": {
        "foreground": "#F2A33C"
      }
    },
    {
      "name": "Invalid (STOP)",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#E2503E",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#A4A6AB",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "foreground": "#7DB592"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "foreground": "#E2503E"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed",
        "punctuation.definition.changed"
      ],
      "settings": {
        "foreground": "#F2A33C"
      }
    },
    {
      "name": "Diff range",
      "scope": [
        "meta.diff.range",
        "meta.diff.header",
        "meta.separator"
      ],
      "settings": {
        "foreground": "#A9B3C1"
      }
    },
    {
      "name": "Heading",
      "scope": [
        "markup.heading",
        "entity.name.section",
        "punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#F2A33C",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#DADBDE",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#DADBDE",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#A4A6AB",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#7FC4CC",
        "fontStyle": "underline"
      }
    },
    {
      "name": "List marker",
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "markup.list punctuation"
      ],
      "settings": {
        "foreground": "#A9B3C1"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#A9B3C1",
    "type": "#A9B3C1",
    "class": "#A9B3C1",
    "interface": "#A9B3C1",
    "struct": "#A9B3C1",
    "enum": "#A9B3C1",
    "typeParameter": "#A9B3C1",
    "type.defaultLibrary": "#A9B3C1",
    "enumMember": "#A79AD0",
    "number": "#A79AD0",
    "regexp": "#A79AD0",
    "function": "#DADBDE",
    "method": "#DADBDE",
    "parameter": "#DADBDE",
    "variable": "#DADBDE",
    "property": "#DADBDE",
    "variable.defaultLibrary": {
      "foreground": "#A9B3C1",
      "italic": true
    },
    "function.defaultLibrary": "#DADBDE",
    "macro": "#F2A33C",
    "keyword": "#F2A33C",
    "decorator": "#F2A33C",
    "comment": {
      "foreground": "#7E8086",
      "italic": true
    },
    "string": "#7FC4CC",
    "operator": "#A4A6AB",
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
