  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#62686F",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage.modifier",
        "keyword.control",
        "storage.type.function",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#8C5306"
      }
    },
    {
      "name": "Operator / punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#454B53"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "markup.inline.raw",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#1F5F66"
      }
    },
    {
      "name": "Constant (Dusk, rare)",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#574A86"
      }
    },
    {
      "name": "Type / structure",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type"
      ],
      "settings": {
        "foreground": "#3F5468"
      }
    },
    {
      "name": "Builtin / self",
      "scope": [
        "variable.language",
        "support.constant",
        "support.variable"
      ],
      "settings": {
        "foreground": "#3F5468",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#16181C"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other.property",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#16181C"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#8C5306"
      }
    },
    {
      "name": "Attribute",
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#3F5468"
      }
    },
    {
      "name": "Regexp / escape",
      "scope": [
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#574A86"
      }
    },
    {
      "name": "Decorator / macro",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "entity.name.function.macro",
        "meta.preprocessor"
      ],
      "settings": {
        "foreground": "#8C5306"
      }
    },
    {
      "name": "Invalid (STOP)",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#A52F1D",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#454B53",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "foreground": "#2A5E41"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "foreground": "#A52F1D"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed",
        "punctuation.definition.changed"
      ],
      "settings": {
        "foreground": "#8C5306"
      }
    },
    {
      "name": "Diff range",
      "scope": [
        "meta.diff.range",
        "meta.diff.header",
        "meta.separator"
      ],
      "settings": {
        "foreground": "#3F5468"
      }
    },
    {
      "name": "Heading",
      "scope": [
        "markup.heading",
        "entity.name.section",
        "punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#8C5306",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#16181C",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#16181C",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#454B53",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#1F5F66",
        "fontStyle": "underline"
      }
    },
    {
      "name": "List marker",
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "markup.list punctuation"
      ],
      "settings": {
        "foreground": "#3F5468"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#3F5468",
    "type": "#3F5468",
    "class": "#3F5468",
    "interface": "#3F5468",
    "struct": "#3F5468",
    "enum": "#3F5468",
    "typeParameter": "#3F5468",
    "type.defaultLibrary": "#3F5468",
    "enumMember": "#574A86",
    "number": "#574A86",
    "regexp": "#574A86",
    "function": "#16181C",
    "method": "#16181C",
    "parameter": "#16181C",
    "variable": "#16181C",
    "property": "#16181C",
    "variable.defaultLibrary": {
      "foreground": "#3F5468",
      "italic": true
    },
    "function.defaultLibrary": "#16181C",
    "macro": "#8C5306",
    "keyword": "#8C5306",
    "decorator": "#8C5306",
    "comment": {
      "foreground": "#62686F",
      "italic": true
    },
    "string": "#1F5F66",
    "operator": "#454B53",
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
