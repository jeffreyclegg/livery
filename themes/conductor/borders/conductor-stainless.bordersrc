#!/bin/bash
# Conductor · Stainless — JankyBorders (focused-window border for AeroSpace).
# Install:  ~/.config/borders/bordersrc (executable). `borders` with no
# arguments runs this file; re-running it restyles a running instance.
# Colors are 0xAARRGGBB.

options=(
  style=round
  width=5.0
  hidpi=on
  # spec: cursor
  active_color=0xff8C5306
  # spec: selection / bright black
  inactive_color=0xff969CA2
)

borders "${options[@]}"
